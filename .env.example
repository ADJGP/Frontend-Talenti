# ============================================================================
# Talenti frontend — variables de entorno
# ============================================================================

# VITE_API_URL — URL base del backend Talenti (FastAPI, repo BD_Bolsa_Trabajo).
#
#   - Vacío (recomendado en desarrollo y en el despliegue Docker/nginx): el SPA
#     llama al MISMO origen y el proxy (de Vite en dev, de nginx en prod)
#     reenvía a la API. El navegador nunca hace una petición cross-origin, así
#     que no se necesita CORS.
#   - URL absoluta (p. ej. https://api.talenti.example): el SPA llama a la API
#     directamente; el backend debe permitir este origen (ver sugerencias.md S-01).
VITE_API_URL=""

# VITE_API_PROXY_TARGET — solo servidor de desarrollo.
# Destino del proxy de Vite cuando VITE_API_URL está vacío.
# Por defecto: http://localhost:8000 (puerto por defecto del stack del backend).
VITE_API_PROXY_TARGET="http://localhost:8000"
